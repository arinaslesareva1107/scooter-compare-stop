import matplotlib.pyplot as plt
import numpy as np

electric_scooters_detailed = {
    "Kugoo Kirin M5": {
        "Максимальная скорость (км/ч)": 55,
        "Запас хода (км)": 60,
        "Мощность мотора (Вт)": 1000,
        "Ёмкость батареи (Ач)": 21,
        "Вес (кг)": 35,
        "Максимальная нагрузка (кг)": 150
    },
    "Ninebot Max G30": {
        "Максимальная скорость (км/ч)": 30,
        "Запас хода (км)": 65,
        "Мощность мотора (Вт)": 350,
        "Ёмкость батареи (Ач)": 15,
        "Вес (кг)": 19.2,
        "Максимальная нагрузка (кг)": 100
    },
    "Xiaomi Mi Electric Scooter Pro 2": {
        "Максимальная скорость (км/ч)": 25,
        "Запас хода (км)": 45,
        "Мощность мотора (Вт)": 300,
        "Ёмкость батареи (Ач)": 12.8,
        "Вес (кг)": 14.2,
        "Максимальная нагрузка (кг)": 100
    },
    "Halten RS-02": {
        "Максимальная скорость (км/ч)": 40,
        "Запас хода (км)": 50,
        "Мощность мотора (Вт)": 800,
        "Ёмкость батареи (Ач)": 18,
        "Вес (кг)": 28,
        "Максимальная нагрузка (кг)": 130
    }
}

models = list(electric_scooters_detailed.keys())
params = ["Максимальная скорость (км/ч)", "Запас хода (км)", 
          "Мощность мотора (Вт)", "Ёмкость батареи (Ач)", 
          "Вес (кг)", "Максимальная нагрузка (кг)"]

data = []
for model in models:
    row = [electric_scooters_detailed[model][p] for p in params]
    data.append(row)

base = data[0]
normalized = []
for row in data:
    norm_row = []
    for i, (val, base_val) in enumerate(zip(row, base)):
        if params[i] == "Вес (кг)":
            norm_row.append(base_val / val)  
        else:
            norm_row.append(val / base_val)
    normalized.append(norm_row)

ktu = [round(sum(row) / len(row), 2) for row in normalized]

plt.figure(figsize=(10, 5))
plt.bar(models, ktu, color='#4CAF50', edgecolor='black')
plt.xlabel("Модель")
plt.ylabel("Коэффициент технического уровня")
plt.title("Интегральный коэффициент качества электросамокатов")
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()

norm_closed = [row + row[:1] for row in normalized]
angles = np.linspace(0, 2 * np.pi, len(params), endpoint=False).tolist()
angles += angles[:1]

max_val = max(max(row) for row in normalized)

fig, ax = plt.subplots(figsize=(8, 8), subplot_kw={'projection': 'polar'})
for i, model in enumerate(models):
    ax.plot(angles, norm_closed[i], 'o-', linewidth=2, label=model)

ax.set_xticks(angles[:-1])
ax.set_xticklabels(params, fontsize=9)
ax.set_ylim(0, max_val * 1.1)
ax.legend(loc='upper right', bbox_to_anchor=(1.3, 1.0))
plt.title("Радиальная диаграмма характеристик\n(нормировано относительно Kugoo Kirin M5)", pad=20)
plt.tight_layout()
plt.show()
